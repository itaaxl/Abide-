{"edition":"fra-lsg","book":"PSA","chapter":114,"verses":[{"v":1,"segs":[{"t":"Quand Israël sortit d’Égypte,","s":"q1","n":1},{"t":"Quand la maison de Jacob s’éloigna d’un peuple barbare,","s":"q1","n":1}]},{"v":2,"segs":[{"t":"Juda devint son sanctuaire,","s":"q1","n":1},{"t":"Israël fut son domaine.","s":"q1","n":1}]},{"v":3,"segs":[{"t":"La mer le vit et s’enfuit,","s":"q1","n":1},{"t":"Le Jourdain retourna en arrière;","s":"q1","n":1}]},{"v":4,"segs":[{"t":"Les montagnes sautèrent comme des béliers,","s":"q1","n":1},{"t":"Les collines comme des agneaux.","s":"q1","n":1}]},{"v":5,"segs":[{"t":"Qu’as-tu, mer, pour t’enfuir,","s":"q1","n":1},{"t":"Jourdain, pour retourner en arrière?","s":"q1","n":1}]},{"v":6,"segs":[{"t":"Qu’avez-vous, montagnes, pour sauter comme des béliers,","s":"q1","n":1},{"t":"Et vous, collines, comme des agneaux?","s":"q1","n":1}]},{"v":7,"segs":[{"t":"Tremble devant le Seigneur, ô terre!","s":"q1","n":1},{"t":"Devant le Dieu de Jacob,","s":"q1","n":1}]},{"v":8,"segs":[{"t":"Qui change le rocher en étang,","s":"q1","n":1},{"t":"Le roc en source d’eaux.","s":"q1","n":1}]}]}