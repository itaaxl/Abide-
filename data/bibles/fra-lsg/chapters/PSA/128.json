{"edition":"fra-lsg","book":"PSA","chapter":128,"verses":[{"v":1,"segs":[{"t":"Cantique des degrés.","s":"q1","n":1},{"t":"Heureux tout homme qui craint l’Éternel,","s":"q1","n":1,"b":1},{"t":"Qui marche dans ses voies!","s":"q1","n":1}]},{"v":2,"segs":[{"t":"Tu jouis alors du travail de tes mains,","s":"q1","n":1},{"t":"Tu es heureux, tu prospères.","s":"q1","n":1}]},{"v":3,"segs":[{"t":"Ta femme est comme une vigne féconde","s":"q1","n":1},{"t":"Dans l’intérieur de ta maison;","s":"q1","n":1},{"t":"Tes fils sont comme des plants d’olivier,","s":"q1","n":1},{"t":"Autour de ta table.","s":"q1","n":1}]},{"v":4,"segs":[{"t":"C’est ainsi qu’est béni","s":"q1","n":1},{"t":"L’homme qui craint l’Éternel.","s":"q1","n":1}]},{"v":5,"segs":[{"t":"L’Éternel te bénira de Sion,","s":"q1","n":1},{"t":"Et tu verras le bonheur de Jérusalem","s":"q1","n":1},{"t":"Tous les jours de ta vie;","s":"q1","n":1}]},{"v":6,"segs":[{"t":"Tu verras les fils de tes fils.","s":"q1","n":1},{"t":"Que la paix soit sur Israël!","s":"q1","n":1}]}]}