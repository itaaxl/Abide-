{"edition":"eng-web","book":"PSA","chapter":148,"verses":[{"v":1,"segs":[{"t":"Praise Yah!","s":"q1","n":1,"b":1},{"t":"Praise Yahweh from the heavens!","s":"q2","n":1},{"t":"Praise him in the heights!","s":"q2","n":1}]},{"v":2,"segs":[{"t":"Praise him, all his angels!","s":"q1","n":1},{"t":"Praise him, all his army!","s":"q2","n":1}]},{"v":3,"segs":[{"t":"Praise him, sun and moon!","s":"q1","n":1},{"t":"Praise him, all you shining stars!","s":"q2","n":1}]},{"v":4,"segs":[{"t":"Praise him, you heavens of heavens,","s":"q1","n":1},{"t":"you waters that are above the heavens.","s":"q2","n":1}]},{"v":5,"segs":[{"t":"Let them praise Yahweh’s name,","s":"q1","n":1},{"t":"for he commanded, and they were created.","s":"q2","n":1}]},{"v":6,"segs":[{"t":"He has also established them forever and ever.","s":"q1","n":1},{"t":"He has made a decree which will not pass away.","s":"q2","n":1}]},{"v":7,"segs":[{"t":"Praise Yahweh from the earth,","s":"q1","n":1},{"t":"you great sea creatures, and all depths,","s":"q2","n":1}]},{"v":8,"segs":[{"t":"lightning and hail, snow and clouds,","s":"q1","n":1},{"t":"stormy wind, fulfilling his word,","s":"q2","n":1}]},{"v":9,"segs":[{"t":"mountains and all hills,","s":"q1","n":1},{"t":"fruit trees and all cedars,","s":"q2","n":1}]},{"v":10,"segs":[{"t":"wild animals and all livestock,","s":"q1","n":1},{"t":"small creatures and flying birds,","s":"q2","n":1}]},{"v":11,"segs":[{"t":"kings of the earth and all peoples,","s":"q1","n":1},{"t":"princes and all judges of the earth,","s":"q2","n":1}]},{"v":12,"segs":[{"t":"both young men and maidens,","s":"q1","n":1},{"t":"old men and children.","s":"q2","n":1}]},{"v":13,"segs":[{"t":"Let them praise Yahweh’s name,","s":"q1","n":1},{"t":"for his name alone is exalted.","s":"q2","n":1},{"t":"His glory is above the earth and the heavens.","s":"q2","n":1}]},{"v":14,"segs":[{"t":"He has lifted up the horn of his people,","s":"q1","n":1},{"t":"the praise of all his saints,","s":"q2","n":1},{"t":"even of the children of Israel, a people near to him.","s":"q2","n":1},{"t":"Praise Yah!","s":"q1","n":1}]}]}