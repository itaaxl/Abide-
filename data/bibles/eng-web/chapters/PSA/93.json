{"edition":"eng-web","book":"PSA","chapter":93,"verses":[{"v":1,"segs":[{"t":"Yahweh reigns!","s":"q1","n":1},{"t":"He is clothed with majesty!","s":"q2","n":1},{"t":"Yahweh is armed with strength.","s":"q2","n":1},{"t":"The world also is established.","s":"q1","n":1},{"t":"It can’t be moved.","s":"q2","n":1}]},{"v":2,"segs":[{"t":"Your throne is established from long ago.","s":"q1","n":1},{"t":"You are from everlasting.","s":"q2","n":1}]},{"v":3,"segs":[{"t":"The floods have lifted up, Yahweh,","s":"q1","n":1},{"t":"the floods have lifted up their voice.","s":"q2","n":1},{"t":"The floods lift up their waves.","s":"q2","n":1}]},{"v":4,"segs":[{"t":"Above the voices of many waters,","s":"q1","n":1},{"t":"the mighty breakers of the sea,","s":"q2","n":1},{"t":"Yahweh on high is mighty.","s":"q2","n":1}]},{"v":5,"segs":[{"t":"Your statutes stand firm.","s":"q1","n":1},{"t":"Holiness adorns your house,","s":"q2","n":1},{"t":"Yahweh, forever more.","s":"q2","n":1}]}]}