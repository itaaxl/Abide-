# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser. Everything else is server-only.

# ---------------------------------------------------------------------------
# Public application configuration (safe to expose)
# ---------------------------------------------------------------------------

# Public base URL of this deployment, used in auth email links, sitemaps and
# share metadata. e.g. https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key. Leave empty to run the site
# without accounts: reading, search, daily verse, plans preview and Watch still work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects call this the "anon" key; either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Show the "Continue with Google" button. Only set to true after enabling the
# Google provider in Supabase (Authentication > Providers).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# ---------------------------------------------------------------------------
# Server-only secrets (never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Supabase service-role ("secret") key. Required for: durable rate limits,
# AI usage quotas, self-service account deletion, admin usage stats, db scripts.
# Without it, AI guidance is disabled (quotas can't be enforced durably).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # legacy name, also accepted

# Anthropic API key for Find Guidance. Leave empty to show the curated,
# clearly labelled topic fallback instead of AI suggestions.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# AI behaviour and cost controls (server-only, all optional)
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic
# Set to false to turn AI off without removing the key.
AI_ENABLED=true
AI_MODEL=claude-opus-5-5
# low | medium | high — reasoning effort per request (cost/latency trade-off)
AI_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
AI_DAILY_LIMIT_PER_USER=10
AI_PER_MINUTE_LIMIT_PER_USER=3
AI_MAX_INPUT_CHARS=1000
# Server-side refusal fallback routing ("default"). Set to off to disable.
AI_FALLBACKS=on
